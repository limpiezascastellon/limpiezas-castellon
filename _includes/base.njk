{%- set canonical = site.url + (page.url | urlLimpia) -%}
{%- set title = title or zona.title -%}
{%- set description = description or zona.description -%}
{%- set faq = faq or zona.faq -%}
{%- if zona %}{% set migas = migas.concat([{"nombre": zona.nombreCorto}]) %}{% endif -%}
{%- set ogImg = imagenOg or imagen or "/img/og-default.jpg" -%}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="robots" content="{{ robots | default('index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1') }}">
<meta name="author" content="{{ site.nombre }}">
<meta name="geo.region" content="ES-VC">
<meta name="geo.placename" content="Castellón de la Plana">
<meta name="geo.position" content="{{ site.lat }};{{ site.lng }}">
<meta name="ICBM" content="{{ site.lat }}, {{ site.lng }}">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/img/icon-192.png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<meta name="theme-color" content="#072B53">
<meta property="og:type" content="{{ ogType | default('website') }}">
<meta property="og:locale" content="es_ES">
<meta property="og:site_name" content="{{ site.nombre }}">
<meta property="og:title" content="{{ ogTitle | default(title) }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ site.url }}{{ ogImg }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content="{{ canonical }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle | default(title) }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImg }}">
{%- if esPortada %}
<link rel="preload" as="image" href="/img/ilustraciones/hero.webp" fetchpriority="high" media="(min-width:981px)">
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="/css/estilos.css">
<link rel="stylesheet" href="/css/estilos.css">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
      "@id": {{ (site.url + "/#empresa") | dump | safe }},
      "name": {{ site.nombre | dump | safe }},
      "description": "Empresa de limpieza profesional en Castellón especializada en comunidades de propietarios, oficinas y locales comerciales.",
      "url": {{ (site.url + "/") | dump | safe }},
      "telephone": {{ site.telefono | dump | safe }},
      "email": {{ site.email | dump | safe }},
      "image": {{ (site.url + "/img/og-default.jpg") | dump | safe }},
      "logo": {{ (site.url + "/img/logo-limpiezas-castellon.png") | dump | safe }},
      "priceRange": "€€",
      "currenciesAccepted": "EUR",
      "slogan": {{ site.claim | dump | safe }},
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ site.calle | dump | safe }},
        "addressLocality": {{ site.localidad | dump | safe }},
        "addressRegion": {{ site.provincia | dump | safe }},
        "postalCode": {{ site.cp | dump | safe }},
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": {{ site.lat }},
        "longitude": {{ site.lng }}
      },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00"
      }],
      "areaServed": [
        { "@type": "City", "name": "Castellón de la Plana" },
        { "@type": "City", "name": "El Grao de Castellón" },
        { "@type": "City", "name": "Vila-real" },
        { "@type": "City", "name": "Onda" },
        { "@type": "City", "name": "Benicàssim" }
      ],
      "knowsLanguage": ["es-ES", "ca-ES"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios de limpieza",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza de comunidades de propietarios" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza de oficinas" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza de locales comerciales" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza de cristales" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza de garajes y parkings" } }
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": {{ (site.url + "/#web") | dump | safe }},
      "url": {{ (site.url + "/") | dump | safe }},
      "name": {{ site.nombre | dump | safe }},
      "inLanguage": "es-ES",
      "publisher": { "@id": {{ (site.url + "/#empresa") | dump | safe }} }
    },
    {
      "@type": "WebPage",
      "@id": {{ (canonical + "#pagina") | dump | safe }},
      "url": {{ canonical | dump | safe }},
      "name": {{ title | dump | safe }},
      "description": {{ description | dump | safe }},
      "inLanguage": "es-ES",
      "isPartOf": { "@id": {{ (site.url + "/#web") | dump | safe }} },
      "about": { "@id": {{ (site.url + "/#empresa") | dump | safe }} }
    }
    {%- if migas %},
    {
      "@type": "BreadcrumbList",
      "@id": {{ (canonical + "#migas") | dump | safe }},
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": {{ (site.url + "/") | dump | safe }} }
        {%- for m in migas %},
        { "@type": "ListItem", "position": {{ loop.index + 1 }}, "name": {{ m.nombre | dump | safe }}{% if m.url %}, "item": {{ (site.url + m.url) | dump | safe }}{% endif %} }
        {%- endfor %}
      ]
    }
    {%- endif %}
    {%- if servicioSchema %},
    {
      "@type": "Service",
      "@id": {{ (canonical + "#servicio") | dump | safe }},
      "name": {{ servicioSchema.nombre | dump | safe }},
      "description": {{ servicioSchema.descripcion | dump | safe }},
      "serviceType": {{ servicioSchema.tipo | dump | safe }},
      "provider": { "@id": {{ (site.url + "/#empresa") | dump | safe }} },
      "areaServed": [
        { "@type": "City", "name": "Castellón de la Plana" },
        { "@type": "City", "name": "El Grao de Castellón" },
        { "@type": "City", "name": "Vila-real" },
        { "@type": "City", "name": "Onda" },
        { "@type": "City", "name": "Benicàssim" }
      ]
    }
    {%- endif %}
    {%- if faq %},
    {
      "@type": "FAQPage",
      "@id": {{ (canonical + "#faq") | dump | safe }},
      "mainEntity": [
        {%- for f in faq %}
        {
          "@type": "Question",
          "name": {{ f.q | dump | safe }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
    {%- endif %}
  ]
}
</script>
</head>
<body>

<a class="sr-only" href="#contenido">Saltar al contenido principal</a>

<!-- BARRA SUPERIOR -->
<div class="topbar">
  <div class="wrap">
    <a href="tel:{{ site.telefonoLink }}" aria-label="Llamar a {{ site.nombre }}"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> {{ site.telefono }}</a>
    <div class="tb-r">
      <a class="tb-mail" href="mailto:{{ site.email }}"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg> {{ site.email }}</a>
      <span style="color:#9fc1dc">{{ site.horario }}</span>
    </div>
  </div>
</div>

<!-- CABECERA -->
<header>
  <div class="wrap nav">
    <a class="logo" href="/" aria-label="{{ site.nombre }} · Ir al inicio">
      <img src="/img/logo-limpiezas-castellon.png" alt="{{ site.nombre }}, empresa de limpieza en Castellón" width="700" height="288" style="height:50px;width:auto">
    </a>
    <nav class="menu" aria-label="Menú principal">
      <a href="/"{% if nav == "inicio" %} class="active" aria-current="page"{% endif %}>Inicio</a>
      <a href="/servicios"{% if nav == "servicios" %} class="active" aria-current="page"{% endif %}>Servicios</a>
      <a href="/nosotros"{% if nav == "nosotros" %} class="active" aria-current="page"{% endif %}>Nosotros</a>
      <a href="/zonas"{% if nav == "zonas" %} class="active" aria-current="page"{% endif %}>Zonas</a>
      <a href="/blog"{% if nav == "blog" %} class="active" aria-current="page"{% endif %}>Blog</a>
      <a href="/contacto"{% if nav == "contacto" %} class="active" aria-current="page"{% endif %}>Contacto</a>
    </nav>
    <div class="nav-cta">
      <a class="nav-phone" href="tel:{{ site.telefonoLink }}"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ site.telefonoCorto }}</a>
      <a class="btn btn-primary" href="/contacto">Pide presupuesto</a>
      <button class="burger" onclick="openMM()" aria-label="Abrir menú" aria-controls="mobileMenu" aria-expanded="false"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<!-- MENÚ MÓVIL -->
<div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Menú de navegación">
  <div class="mm-top">
    <img src="/img/logo-limpiezas-castellon.png" alt="{{ site.nombre }}" width="700" height="288" style="height:36px;width:auto;filter:brightness(0) invert(1)">
    <button class="mm-close" onclick="closeMM()" aria-label="Cerrar menú">&times;</button>
  </div>
  <a href="/">Inicio</a>
  <a href="/servicios">Servicios</a>
  <a href="/nosotros">Nosotros</a>
  <a href="/zonas">Zonas de servicio</a>
  <a href="/blog">Blog</a>
  <a href="/contacto">Contacto</a>
  <a class="btn btn-primary" href="/contacto">Pide presupuesto gratis</a>
  <a class="mm-call" href="tel:{{ site.telefonoLink }}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Llámanos: {{ site.telefonoCorto }}</a>
</div>

<main id="contenido">
{{ content | safe }}
</main>

<!-- PIE -->
<footer>
  <div class="wrap">
    <div class="fgrid-foot">
      <div>
        <div class="foot-logo">
          <img src="/img/logo-limpiezas-castellon.png" alt="{{ site.nombre }}" width="700" height="288" loading="lazy" style="height:46px;width:auto;filter:brightness(0) invert(1);opacity:.95">
        </div>
        <p>Especialistas en la limpieza de comunidades de propietarios y oficinas en Castellón, con más de {{ site.anios }} años de experiencia.</p>
        <p class="hashtag">#LaLimpiezaNosImporta</p>
      </div>
      <div>
        <h5>Servicios</h5>
        <div class="foot-links">
          <a href="/limpieza-de-comunidades-castellon">Limpieza de comunidades</a>
          <a href="/limpieza-de-oficinas-castellon">Limpieza de oficinas</a>
          <a href="/servicios#locales">Locales comerciales</a>
          <a href="/servicios#cristales">Limpieza de cristales</a>
          <a href="/servicios#garajes">Garajes y parkings</a>
        </div>
      </div>
      <div>
        <h5>Dónde trabajamos</h5>
        <div class="foot-links">
          <a href="/">Limpieza en Castellón</a>
          {%- for z in zonas %}
          <a href="/{{ z.slug }}">Limpieza en {{ z.nombreCorto }}</a>
          {%- endfor %}
        </div>
      </div>
      <div>
        <h5>Contacto</h5>
        <div class="foot-contact">
          <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> {{ site.direccion }}</div>
          <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> <a href="tel:{{ site.telefonoLink }}">{{ site.telefono }}</a></div>
          <div><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg> <a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
          <div><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> {{ site.horario }}</div>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {{ "now" | anio }} {{ site.nombre }} · Todos los derechos reservados.</span>
      <div style="display:flex;gap:20px;flex-wrap:wrap">
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/politica-de-privacidad">Política de privacidad</a>
        <a href="/politica-de-cookies">Política de cookies</a>
      </div>
    </div>
  </div>
</footer>

<!-- BOTONES FLOTANTES -->
<div class="float-wa">
  <a class="fw-call" href="tel:{{ site.telefonoLink }}" aria-label="Llamar por teléfono"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.04 15.04 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.02A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1 17 17 0 0 0 17 17 1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/></svg></a>
  <a class="fw-wa" href="{{ site.whatsapp }}" rel="noopener" aria-label="Escribir por WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.9.9-2.8-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.2 0-.4 0-.5l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3c-.3.3-.9.9-.9 2.1s.9 2.5 1 2.6 1.8 2.8 4.4 3.9c1.6.7 2.2.7 3 .6.5 0 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1z"/></svg></a>
</div>

<script>
function openMM(){
  document.getElementById('mobileMenu').classList.add('open');
  document.body.classList.add('no-scroll');
  var b=document.querySelector('.burger'); if(b) b.setAttribute('aria-expanded','true');
}
function closeMM(){
  document.getElementById('mobileMenu').classList.remove('open');
  document.body.classList.remove('no-scroll');
  var b=document.querySelector('.burger'); if(b) b.setAttribute('aria-expanded','false');
}
document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeMM(); });
window.addEventListener('resize',function(){ if(window.innerWidth>900) closeMM(); });

(function(){
  var els=document.querySelectorAll('.reveal');
  if(!('IntersectionObserver' in window)){ els.forEach(function(el){el.classList.add('in')}); return; }
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e,i){ if(e.isIntersecting){ setTimeout(function(){e.target.classList.add('in')}, i*60); io.unobserve(e.target); } });
  },{threshold:.12});
  els.forEach(function(el){ io.observe(el); });
})();

// Formulario de presupuesto (solo actúa en la página de contacto)
function enviarPresupuesto(){
  var msg = document.getElementById('formMsg');
  var btn = document.getElementById('f-enviar');
  var nombre = document.getElementById('f-nombre').value.trim();
  var telefono = document.getElementById('f-telefono').value.trim();
  var email = document.getElementById('f-email').value.trim();
  var acepto = document.getElementById('f-acepto').checked;

  function aviso(texto, ok){
    msg.style.display='block';
    msg.style.background = ok ? '#E6F8F4' : '#FBE9E7';
    msg.style.color = ok ? '#0E7C6F' : '#C0392B';
    msg.textContent = texto;
  }

  if(!nombre){ aviso('Escribe tu nombre para poder responderte.', false); return; }
  if(!telefono && !email){ aviso('Déjanos un teléfono o un email para poder responderte.', false); return; }
  if(!acepto){ aviso('Acepta la política de privacidad para enviar la solicitud.', false); return; }

  btn.disabled = true; btn.textContent = 'Enviando…';

  fetch('/api/presupuesto', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      nombre: nombre,
      telefono: telefono,
      email: email,
      servicio: document.getElementById('f-servicio').value,
      poblacion: document.getElementById('f-poblacion') ? document.getElementById('f-poblacion').value : '',
      mensaje: document.getElementById('f-mensaje').value.trim(),
      web: document.getElementById('f-web').value
    })
  }).then(function(r){ return r.json(); }).then(function(j){
    if(j.ok){
      aviso('Solicitud recibida. Te respondemos en menos de 24h.', true);
      ['f-nombre','f-telefono','f-email','f-mensaje'].forEach(function(id){ document.getElementById(id).value=''; });
      document.getElementById('f-acepto').checked=false;
    } else {
      aviso(j.error || 'No se ha podido enviar. Inténtalo de nuevo o llámanos al {{ site.telefonoCorto }}.', false);
    }
  }).catch(function(){
    aviso('No se ha podido enviar. Inténtalo de nuevo o llámanos al {{ site.telefonoCorto }}.', false);
  }).finally(function(){
    btn.disabled=false; btn.textContent='Enviar solicitud';
  });
}
</script>
</body>
</html>
